# Copy this file to .env and fill in what you have.
# With no OPENAI_API_KEY the backend runs in DEMO MODE (sample content, browser voices).

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Optional: Azure Speech pronunciation assessment (also run: pip install -r requirements-azure.txt)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Set to 1 to force demo mode even when a key is present
SOFTUTTER_MOCK=0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
